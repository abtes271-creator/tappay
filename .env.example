# Copy this file to ".env" in the same folder as docker-compose.yml and fill
# in real values. Without these, email and SMS notifications silently no-op
# (they log a warning instead of throwing, so the app still works - you just
# won't receive anything).

# --- Email (Resend) ---
# Sent via Resend's HTTPS API, not SMTP - most hosts (Render included) block
# outbound SMTP ports, so Gmail SMTP works locally but silently fails once
# deployed. HTTPS is never blocked.
# 1. Sign up free at https://resend.com
# 2. Create an API key at https://resend.com/api-keys (starts with "re_").
# 3. Until you verify your own domain in Resend, FROM_EMAIL must stay as
#    onboarding@resend.dev, and you can only send TO the address you signed
#    up with. Verify a domain in Resend once you're ready to email real
#    customers/institutions at their own addresses.
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=admin@example.com
ADMIN_NOTIFICATION_PHONE=

# --- SMS (Twilio) ---
# Get these from your Twilio console: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- First admin account (change before first run) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_EMAIL=admin@example.com

# Public URL where the frontend is served - used to build password-reset links
FRONTEND_URL=http://localhost:5173
